# --- Supabase ---
# Projekt-URL und Keys findest du im Supabase-Dashboard unter:
# Project Settings -> API
#
# WICHTIG: Das Supabase-Projekt in der EU-Region anlegen (Frankfurt / eu-central-1),
# siehe README.

# Öffentliche Projekt-URL. Darf im Browser sichtbar sein.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Öffentlicher Anon-Key. Darf im Browser sichtbar sein. Der Zugriff wird über
# Row Level Security in der Datenbank begrenzt.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-Role-Key. GEHEIM. Umgeht Row Level Security vollständig.
# NUR serverseitig verwenden (kein NEXT_PUBLIC_ Prefix!). Niemals ins
# Git-Repository committen oder an den Browser ausliefern.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
